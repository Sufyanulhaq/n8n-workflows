{
  "name": "Daily sales digest",
  "nodes": [
    {
      "id": "n38",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "n39",
      "name": "Test run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "parameters": {}
    },
    {
      "id": "n41",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        280
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "n40",
              "name": "base_url",
              "value": "http://localhost:8140",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "n42",
      "name": "Get yesterday's orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        280
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Settings').first().json.base_url }}/sales",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 500,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "n43",
      "name": "Write the digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// An empty list from the API arrives as one empty item, so only keep real orders.\nconst orders = $input.all().map((i) => i.json).filter((o) => o.id !== undefined && o.status !== 'cancelled');\nif (!orders.length) return [{ json: { text: 'No orders yesterday.' } }];\nconst revenue = orders.reduce((s, o) => s + o.total, 0);\nconst byProduct = {};\nfor (const o of orders) for (const l of o.items) byProduct[l.product] = (byProduct[l.product] || 0) + l.amount;\nconst top = Object.entries(byProduct).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([p, v]) => p + ' ' + v.toFixed(2));\nreturn [{ json: { text: 'Yesterday: ' + orders.length + ' orders, ' + revenue.toFixed(2) + ' revenue. Top products: ' + top.join(', ') + '.' } }];\n"
      }
    },
    {
      "id": "n44",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        280
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.base_url }}/slack",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 500,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Test run": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Get yesterday's orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get yesterday's orders": {
      "main": [
        [
          {
            "node": "Write the digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write the digest": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
