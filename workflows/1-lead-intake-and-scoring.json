    {
      "id": "n12",
      "name": "Score lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// Same visible rules as the Lead Qualification Agent repo. Change the numbers to suit your business.\nconst src = $input.first().json;\nconst lead = src.body || src;\nconst text = String(lead.need || '').toLowerCase();\nconst SERVICES = {\n  chatbot: ['chatbot', 'chat bot', 'assistant', 'support bot', 'customer support'],\n  automation: ['automate', 'automation', 'workflow', 'n8n', 'zapier', 'repetitive', 'manual'],\n  integration: ['integrat', 'api', 'webhook', 'connect', 'crm', 'sync'],\n  'web app': ['web app', 'website', 'dashboard', 'portal', 'saas', 'mvp', 'admin panel', 'platform'],\n  documents: ['pdf', 'document', 'invoice', 'contract'],\n  email: ['email', 'inbox'],\n  data: ['scrap', 'spreadsheet', 'report', 'etl', 'data pipeline'],\n};\nconst services = Object.keys(SERVICES).filter((k) => SERVICES[k].some((w) => text.includes(w))).sort();\nconst reasons = [];\nlet fit = services.length >= 2 ? 25 : services.length === 1 ? 18 : 5;\nreasons.push(services.length ? 'clear need: ' + services.join(', ') : 'need is vague');\nlet budget = 8; const amount = lead.budget_amount;\nif (amount != null && amount !== '') {\n  const a = Number(amount);\n  budget = a >= 5000 ? 30 : a >= 2000 ? 24 : a >= 1000 ? 18 : a >= 500 ? 10 : 4;\n  reasons.push('budget of ' + a);\n} else reasons.push('budget not given');\nlet timeline = 8; const months = lead.timeline_months;\nif (months != null && months !== '') {\n  const m = Number(months);\n  timeline = m <= 1 ? 25 : m <= 3 ? 15 : 6;\n  reasons.push(m <= 1 ? 'wants to start within a month' : m <= 3 ? 'wants to start within three months' : 'timeline is more than three months away');\n} else reasons.push('no timeline given');\nconst contact = (lead.email ? 12 : 0) + (lead.company ? 4 : 0) + (lead.name ? 4 : 0);\nconst missing = ['email', 'company', 'name'].filter((k) => !lead[k]);\nreasons.push(missing.length ? 'missing ' + missing.join(', ') : 'full contact details');\nconst total = fit + budget + timeline + contact;\nlet label = total >= 70 ? 'Hot' : total >= 45 ? 'Warm' : 'Cold';\nif (!lead.email && label !== 'Cold') { label = 'Cold'; reasons.push('held at Cold because there is no email to follow up on'); }\nreturn [{ json: { ...lead, services, score: total, label, reasons } }];\n"
      }
    },
    {
      "id": "n14",
      "name": "Is it hot?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "n13",
              "leftValue": "={{ $json.label }}",
              "rightValue": "Hot",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n15",
      "name": "Create CRM contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.base_url }}/crm/contacts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'lead:' + $json.email }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.name, company: $json.company, email: $json.email, score: $json.score, label: $json.label, reasons: $json.reasons }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 500,
      "onError": "continueRegularOutput"
    },
    {
      "id": "n16",
      "name": "Tell the sales team",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.base_url }}/slack",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'Hot lead ' + $('Score lead').first().json.score + '/100: ' + $('Score lead').first().json.name + ' at ' + $('Score lead').first().json.company }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 500,
      "onError": "continueRegularOutput"
    },
    {
      "id": "n17",
