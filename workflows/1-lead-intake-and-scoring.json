        "url": "={{ $('Settings').first().json.base_url }}/sheets",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ row: [$json.name || '', $json.company || '', $json.email || '', $json.score, $json.label] }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 500,
      "onError": "continueRegularOutput"
    },
    {
      "id": "n18",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
